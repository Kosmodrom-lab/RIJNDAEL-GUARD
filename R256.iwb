' ===============================================================================
' ONE-TIME GDI+ IMAGE LOADER FROM DATA BLOCK
' Call this ONCE at startup to load g_app.pGpAboutLogo
' ===============================================================================
SUB LoadAboutLogoData()
    INT totalBytes = 2048 ' <-- Replace with exact byte count from DATAmake output
    INT hMem = 0
    POINTER pMemBuf = NULL
    POINTER pStream = NULL
    INT i = 0, bVal = 0

    IF totalBytes <= 0 THEN RETURN

    ' 1. Allocate movable memory block
    hMem = GlobalAlloc(0x0002, totalBytes) ' GMEM_MOVEABLE = 0x0002
    IF hMem = 0 THEN RETURN

    pMemBuf = GlobalLock(hMem)
    IF pMemBuf <> NULL THEN
        
        ' Restore data pointer to block
        RESTORE(png_logo_Data)

        FOR i = 0 TO totalBytes - 1
            GETDATA(png_logo_Data, bVal)
            
            ' Write byte directly into heap memory block
            #<CHAR>(pMemBuf + i) = (bVal & 0xFF)
        NEXT i

        GlobalUnlock(hMem)

        ' 3. Create IStream and construct GDI+ Image
        IF CreateStreamOnHGlobal(hMem, 1, &pStream) = 0 THEN
            GdipLoadImageFromStream(pStream, &g_app.pGpAboutLogo)
        ENDIF
    ENDIF
ENDSUB


