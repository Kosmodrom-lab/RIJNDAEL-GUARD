' ===============================================================================
' DISK SPACE PRE-CHECK HELPER
' ===============================================================================

SUB HasSufficientDiskSpace(filePath AS STRING, bytesNeeded AS DOUBLE), INT
    LARGE_INTEGER freeBytes, totalBytes, totalFree
    DOUBLE freeDouble = 0.0
    STRING driveRoot = ""
    
    IF MID$(filePath, 2, 1) = ":" THEN
        driveRoot = LEFT$(filePath, 3)
    ELSE
        driveRoot = GETSTARTPATH
    ENDIF

    IF GetDiskFreeSpaceExA(driveRoot, &freeBytes, &totalBytes, &totalFree) <> 0 THEN
        IF freeBytes.LowPart < 0 THEN
            freeDouble = (4294967296.0 + freeBytes.LowPart) + (freeBytes.HighPart * 4294967296.0)
        ELSE
            freeDouble = freeBytes.LowPart + (freeBytes.HighPart * 4294967296.0)
        ENDIF

        IF freeDouble >= (bytesNeeded * 1.05) THEN RETURN 1
    ENDIF

    RETURN 0
ENDSUB

' ===============================================================================
' FILE STATUS & CRYPTOGRAPHIC MARKER INSPECTOR
' ===============================================================================

SUB CheckFileStatusAndMarker(STRING filePath)
    INT hFile = INVALID_HANDLE_VALUE
    DEF headerBytes[16] AS CHAR
    INT bytesRead = 0
    STRING marker = ""
    INT i

    g_app.isProtectedMarker = 0

    IF LEN(filePath) = 0 THEN RETURN

    IF GetFileAttributesA(filePath) = INVALID_FILE_ATTRIBUTES THEN
        g_app.statusMsg = "Warning: Target file no longer exists on disk!"
        InvalidateRect(g_app.win.hwnd, NULL, 0)
        RETURN
    ENDIF

    hFile = CreateFileA(filePath, GENERIC_READ, FILE_SHARE_READ, 0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)
    IF hFile <> INVALID_HANDLE_VALUE THEN
        ReadFile(hFile, &headerBytes, 16, &bytesRead, 0)
        CloseHandle(hFile)

        IF bytesRead >= 9 THEN
            marker = ""
            FOR i = 0 TO 8
                marker = marker + CHR$(headerBytes[i] & 0xFF)
            NEXT i

            IF marker = "RGUARD256" THEN
                g_app.isProtectedMarker = 1
                g_app.statusMsg = "File Tagged: Already Protected with RGUARD256."
            ELSE
                g_app.statusMsg = "File Tagged: Unprotected Raw Payload."
            ENDIF
        ENDIF
    ENDIF

    InvalidateRect(g_app.win.hwnd, NULL, 0)
ENDSUB

' ===============================================================================
' 64-BIT FILE SIZE HELPER
' ===============================================================================

SUB GetFileSize64(hFile AS INT), DOUBLE
    LARGE_INTEGER liSize
    DOUBLE dblSize = 0.0
    
    IF GetFileSizeEx(hFile, &liSize) <> 0 THEN
        IF liSize.LowPart < 0 THEN
            dblSize = (4294967296.0 + liSize.LowPart) + (liSize.HighPart * 4294967296.0)
        ELSE
            dblSize = liSize.LowPart + (liSize.HighPart * 4294967296.0)
        ENDIF
    ENDIF
    
    RETURN dblSize
ENDSUB

' ===============================================================================
' HIGH-SPEED WIN32 BLOCK SHREDDER (1 MB Streaming Pipeline)
' ===============================================================================
SUB FastShredFileWin32(STRING filePath, DOUBLE totalBytes)
    UINT hFile = INVALID_HANDLE_VALUE
    POINTER pWipeBuf = NULL
    INT wipeChunkSize = 1048576 ' 1 MB High-Throughput Buffer
    UINT bytesWritten = 0
    INT pass, numPasses = 1     ' 1 pass is optimal for SSDs (change to 3 if HDD mandated)
    DOUBLE bytesWiped = 0.0

    ' Allocate 1 MB alignment buffer
    IF ALLOCMEM(pWipeBuf, 1, wipeChunkSize) <> 0 THEN RETURN

    ' Open handle ONCE in unbuffered sequential write mode (FILE_FLAG_SEQUENTIAL_SCAN = 0x08000000)
    hFile = CreateFileA(filePath, GENERIC_WRITE, 0, 0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL | 0x08000000, 0)
    IF hFile <> INVALID_HANDLE_VALUE AND hFile <> -1 THEN

        FOR pass = 1 TO numPasses
            g_app.statusMsg = "Sanitizing data ..." '(Pass " + STR$(pass) + "/" + STR$(numPasses) + ")..."
            InvalidateRect(g_app.win.hwnd, NULL, 0)

            ' Fast memory fill using standard zeroing or byte pattern
            ' (Pass 1 = 0x00, Pass 2 = 0xFF, Pass 3 = 0x55)
            CHAR fillVal = 0x00
            IF pass = 2 THEN fillVal = 0xFF
            IF pass = 3 THEN fillVal = 0x55

            ' Fill 1 MB buffer instantly using Win32 API FillMemory
            FillMemory(pWipeBuf, wipeChunkSize, fillVal)

            ' Rewind file pointer to beginning for subsequent passes
            SetFilePointer(hFile, 0, 0, 0) ' 0 = FILE_BEGIN

            bytesWiped = 0.0
            WHILE bytesWiped < totalBytes
                INT toWrite = wipeChunkSize
                IF (totalBytes - bytesWiped) < wipeChunkSize THEN
                    toWrite = INT(totalBytes - bytesWiped)
                ENDIF

                WriteFile(hFile, pWipeBuf, toWrite, &bytesWritten, 0)
                bytesWiped = bytesWiped + toWrite
            ENDWHILE
        NEXT pass

        ' Ensure data is committed to platter/NAND before closing
        FlushFileBuffers(hFile)
        CloseHandle(hFile)

        ' Truncate file length to 0 bytes to destroy file footprint before deletion
        hFile = CreateFileA(filePath, GENERIC_WRITE, 0, 0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)
        IF hFile <> INVALID_HANDLE_VALUE AND hFile <> -1 THEN
            SetFilePointer(hFile, 0, 0, 0)
            SetEndOfFile(hFile)
            CloseHandle(hFile)
        ENDIF

        ' Unlink file from file system table
        DeleteFileA(filePath)
    ENDIF

    FREEMEM pWipeBuf
ENDSUB

' ===============================================================================
' NATIVE WIN32 + ZLIB COMPRESSION ENGINE
' ===============================================================================
/*
SUB CompressFileGzWin32(STRING srcFile, STRING outFile), INT
    INT hFileIn = INVALID_HANDLE_VALUE
    INT gzHandle = 0
