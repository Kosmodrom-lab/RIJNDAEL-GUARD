    POINTER pLogTab
    POINTER pSBox
    POINTER pKeyArray
    POINTER pCFBBuf
    POINTER pDropBuf
    POINTER pLogBuffer

    ' Memory Size & Tracking
    INT logBufSize
    INT logBufUsed
    INT gdiToken
    INT gdiRefCount
    INT isProcessing
    INT hasZlibDll
    INT isProtectedMarker

