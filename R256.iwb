/* 
 * Rijndael Guard - Native GDI+ Skinned Engine (3-Panel Viewport Stage)
 * Target Environment: IWBasic 2.5 + Native GDI+ Flat API + Win32 ZLIB
 * Filename: R256.iwb
 */

AUTODEFINE "Off"

$INCLUDE "windowssdk.inc"
$INCLUDE "gdiplus.inc"

' Link against standard static/import zlib library
$USE "zlib.lib"

' ===============================================================================
' ZLIB 1.2.x DLL EXPORTS & STRUCTURES
' ===============================================================================
TYPE z_stream
    POINTER next_in
    INT     avail_in
    INT     total_in
    POINTER next_out
    INT     avail_out
    INT     total_out
    POINTER msg
    POINTER state
    POINTER zalloc
    POINTER zfree
    POINTER opaque
    INT     data_type
    INT     adler
    INT     reserved
ENDTYPE

CONST Z_OK            = 0
CONST Z_STREAM_END    = 1
CONST Z_NO_FLUSH      = 0
CONST Z_FINISH        = 4
CONST Z_DEFLATED      = 8
CONST MAX_WBITS       = 15

' ===============================================================================
' ZLIB 1.2.x DLL EXPORTS (Strict IWBasic DECLARE CDECL Syntax)
' ===============================================================================
DECLARE CDECL IMPORT, deflateInit2_ ALIAS "deflateInit2_"(strm AS POINTER, level AS INT, method AS INT, windowBits AS INT, memLevel AS INT, strategy AS INT, version AS POINTER, stream_size AS INT), INT
DECLARE CDECL IMPORT, deflate(strm AS POINTER, flush AS INT), INT
DECLARE CDECL IMPORT, deflateEnd(strm AS POINTER), INT
' ===============================================================================
' ZLIB EXTERN DECLARATIONS
' ===============================================================================
DECLARE CDECL EXTERN gzopen(path AS STRING, mode AS STRING), INT
DECLARE CDECL EXTERN gzwrite(gzFile AS INT, buf AS POINTER, length AS INT), INT
DECLARE CDECL EXTERN gzread(gzFile AS INT, buf AS POINTER, length AS INT), INT
DECLARE CDECL EXTERN gzclose(gzFile AS INT), INT
DECLARE CDECL EXTERN gzflush(gzFile AS INT, flush AS INT), INT
' Win32 API Import Alias (Resolves collision with IWBasic LINE command)
DECLARE IMPORT, LineToWin32 ALIAS LineTo(hdc AS UINT, x AS INT, y AS INT), INT
' Unique alias to avoid any language keyword collision
DECLARE IMPORT, Win32ShowWindow ALIAS ShowWindow(hwnd AS UINT, nCmdShow AS INT), INT

